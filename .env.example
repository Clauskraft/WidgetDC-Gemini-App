# =========================================================================
# WidgeTDC Aurora — environment template. Copy to `.env` and fill in.
# `.env` is gitignored. Never commit real secrets. VITE_*-prefixed values
# are PUBLIC (shipped to the browser) — never put a secret behind a VITE_ key.
# =========================================================================

# --- Supabase (auth + thread persistence) ---
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""          # anon/publishable key — server-side reads
VITE_SUPABASE_PROJECT_ID=""          # public — client SDK
VITE_SUPABASE_URL=""                 # public — client SDK
VITE_SUPABASE_PUBLISHABLE_KEY=""     # public — client SDK (anon key only!)

# --- WidgetDC platform (server-only — must NEVER reach the bundle) ---
# Chat, RAG grounding and canvas all route through the WidgeTDC orchestrator MCP
# (POST {WIDGETDC_BACKEND_URL}/api/mcp/route, body {tool,payload}, Bearer auth).
# WIDGETDC_API_KEY is required for chat (api/chat.ts -> llm_chat). MCP_AGENT_API_KEY
# is accepted as a fallback for the same Bearer token.
WIDGETDC_API_KEY=""
MCP_AGENT_API_KEY=""
WIDGETDC_BACKEND_URL="https://backend-production-d3da.up.railway.app"
WIDGETDC_ORCHESTRATOR_URL="https://orchestrator-production-c27e.up.railway.app"
WIDGETDC_ORCHESTRATOR_API_KEY=""     # optional separate key for orchestrator-only tools

# --- Observability: forward error/audit logs to the platform EventSpine (AUR-12) ---
# Opt-in. When "1"/"true", server-logger ships error-level and audit-flagged
# events to the platform via the sink tool below (default governance.emit_spine_event)
# so governance_audit_query / eventspine_replay can correlate frontend failures.
# Best-effort and fire-and-forget — never affects the request path.
WIDGETDC_LOG_FORWARD=""               # "1" to enable; empty/unset = local logging only
WIDGETDC_LOG_SINK_TOOL=""             # optional override; defaults to governance.emit_spine_event

# --- Canvas bridge signing (src/lib/widgetdcContracts.server.ts) ---
# HMAC secret for signed embed-canvas tokens. Falls back to WIDGETDC_API_KEY,
# then a dev default — set a real value in production.
CANVAS_SIGNING_SECRET=""
CANVAS_TOKEN_TTL_SECONDS="3600"
